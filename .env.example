# Copie para .env.local (nunca comite .env.local).
# Valores abaixo são do ambiente de DESENVOLVIMENTO (docker-compose.dev.yml).
# Em produção os valores vêm do ambiente do servidor, fora do repositório.

# Runtime do app — usuário SEM bypass de RLS
DATABASE_URL=postgres://factoria_app:dev_app@localhost:5434/factoria_saas
# Migrations (drizzle-kit) — dono do schema
MIGRATIONS_DATABASE_URL=postgres://factoria_owner:dev_owner@localhost:5434/factoria_saas
# BullMQ — DB lógico 2 (mesmo esquema da produção)
REDIS_URL=redis://localhost:6380/2
APP_DOMAIN=localhost:3000

# Better Auth — em produção: `openssl rand -base64 32` e BETTER_AUTH_URL=https://app.seudominio.com
BETTER_AUTH_SECRET=dev-only-secret-troque-em-producao-0123456789
BETTER_AUTH_URL=http://localhost:3000

# Chatwoot (Platform API) — opcional em dev; sem isso, o onboarding só não cria a conta no Chatwoot.
# Token da Platform App do Chatwoot (nunca comite).
CHATWOOT_URL=http://localhost:3100
CHATWOOT_PLATFORM_TOKEN=
# Prefixo do nome das contas criadas (padrão "[dev] " fora de produção)
# CHATWOOT_ACCOUNT_PREFIX=

# Fotos (cardápio, logo, capa). Vazio em desenvolvimento = pasta local .media/
# Produção: bucket PRIVADO no Backblaze B2 + chave restrita a esse bucket (Read and Write).
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_KEY_ID=
MEDIA_S3_SECRET=
# MEDIA_S3_REGION=   (deduzida do endpoint)

# WhatsApp provisório (Evolution API, rede interna). Sem estas variáveis, o WhatsApp fica desligado.
# EVOLUTION_URL=http://factoria-evolution:8080
# EVOLUTION_API_KEY=            # a mesma AUTHENTICATION_API_KEY do .env da Evolution
# EVOLUTION_WEBHOOK_SECRET=     # openssl rand -hex 32 (a Evolution manda no cabeçalho x-factoria-secret)
# APP_INTERNAL_URL=http://factoria-app:3000

# Avisos de pedido novo no Telegram (bot da Factoria, criado no @BotFather). Sem token, nada é enviado.
# TELEGRAM_BOT_TOKEN=          # segredo: só no servidor
# TELEGRAM_BOT_USERNAME=       # ex.: FactoriaPedidosBot (aparece nas instruções do painel)
